# Configure apenas o provedor escolhido e deixe as outras variaveis de API vazias.

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=
GOOGLE_CHAT_MODEL=

# PostgreSQL do docker-compose.yml (acesso a partir da maquina local)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PG_VECTOR_COLLECTION_NAME=pdf_document
PDF_PATH=document.pdf
